---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PostView from "@components/PostView.astro";
import { getBlogEntryLanguage, getCollectionSlug } from "@lib/slug-utils";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((p) => {
      if (p.data.draft) return false;
      try {
        return getBlogEntryLanguage(p) === "en";
      } catch {
        return false;
      }
    })
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post) => ({
    params: { slug: getCollectionSlug(post) },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;
const post = Astro.props;
const { headings } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <PostView kind="blog" post={post} headings={headings} locale="en" />
</PageLayout>
