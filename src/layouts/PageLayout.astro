---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import { getLocaleFromPath } from "@lib/i18n";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;

const animation = {
  old: [
    {
      name: "kws-pageout",
      duration: "180ms",
      easing: "ease-out",
      fillMode: "forwards" as const,
    },
  ],
  new: [
    {
      name: "kws-pagein",
      duration: "700ms",
      easing: "cubic-bezier(0.16, 1, 0.3, 1)",
      fillMode: "both" as const,
    },
  ],
};

const kwsPagein = { forwards: animation, backwards: animation };
---

<!doctype html>
<html lang={getLocaleFromPath(Astro.url.pathname)}>
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    <Header />
    <main transition:animate={kwsPagein}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @keyframes kws-pagein {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes kws-pageout {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
