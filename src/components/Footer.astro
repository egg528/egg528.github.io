---
import { SITE } from "@consts";
const year = new Date().getFullYear();
---

<footer class="kws-foot">
  <span>© {year} | {SITE.NAME}</span>
</footer>

<style>
  .kws-foot {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-6) var(--container-pad) var(--space-10);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    letter-spacing: 0.02em;
  }
</style>
